---
// Zmiana procentowa: liczba w kolorze tekstu, kierunek pokazuje mały trójkąt (z CSS,
// bez SVG w każdej komórce tabeli: strony z setkami lokali są dużo lżejsze).
import { pct } from '../lib/format';
interface Props { value: number | null; digits?: number }
const { value, digits = 1 } = Astro.props;
const dir = value === null || Math.abs(value) < 0.0005 ? 0 : value > 0 ? 1 : -1;
---
<span class:list={['change num', dir > 0 && 'up', dir < 0 && 'down']}>{pct(value, digits)}</span>
